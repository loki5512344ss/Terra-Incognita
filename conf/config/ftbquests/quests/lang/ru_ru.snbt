{
	chapter.19046C8F78B9C928.chapter_subtitle: ["Нефть, двигатели, пушки и небо"]
	chapter.19046C8F78B9C928.title: "6. Тяжёлая индустрия"
	chapter.24C6791C85D15F90.chapter_subtitle: ["Валы, шестерни и первые машины"]
	chapter.24C6791C85D15F90.title: "1. Андезит"
	chapter.2FEA7F27C95382C3.chapter_subtitle: ["Трубы, баки и пар"]
	chapter.2FEA7F27C95382C3.title: "2. Медь и жидкости"
	chapter.467B3D53C675C9E9.chapter_subtitle: ["Посылки, склад и рельсы"]
	chapter.467B3D53C675C9E9.title: "5. Логистика и поезда"
	chapter.5556FECB89D4939B.chapter_subtitle: ["Прочти сначала: что здесь по-другому и как это работает"]
	chapter.5556FECB89D4939B.title: "Начало"
	chapter.5B2FAD26E95A38A9.chapter_subtitle: ["Провода, моторы и доменная печь"]
	chapter.5B2FAD26E95A38A9.title: "4. Электричество и сталь"
	chapter.7F3F8DCEEA9E4452.chapter_subtitle: ["Точность и автоматизация"]
	chapter.7F3F8DCEEA9E4452.title: "3. Латунь"
	chapter_group.21E3E8CB980B7B8A.title: "Terra Incognita"
	file.0000000000000001.title: "Terra Incognita"
	quest.036B24005742EE4F.quest_desc: [
		"Доменная печь, расплав, литьё. Любой рецепт, где нужна сталь, принимает этот слиток."
		""
		"Сталь открывает ступень 6, &eТяжёлую индустрию&r."
	]
	quest.036B24005742EE4F.quest_subtitle: "Единственная сталь"
	quest.07D35ABEE8E840D3.quest_subtitle: "Инструменты"
	quest.097A4CBE15399FE2.quest_desc: [
		"&eСолнце&r и &eлуна&r встают на &eвостоке&r и садятся на &eзападе&r. Утром солнце на востоке, вечером — на западе."
		""
		"&eОблака&r всегда плывут на запад. Это работает в любое время суток."
		""
		"&eКомпас&r, когда сможешь его скрафтить, указывает на твою точку спавна."
	]
	quest.097A4CBE15399FE2.quest_subtitle: "Компас на небе"
	quest.097A4CBE15399FE2.title: "Солнце и луна"
	quest.0B4E57A5601D7897.quest_desc: [
		"&eЛатунь&r открывает умные машины: автономные активаторы, механические крафтеры, фильтры и контроллеры."
		""
		"&eТочный механизм&r — главная деталь этой ступени. Он нужен для компаса и рации."
	]
	quest.0B4E57A5601D7897.quest_subtitle: "Медь и цинк на огне"
	quest.1266E483FD0E9F20.quest_subtitle: "Посылки"
	quest.17B27771CDB86A5A.quest_desc: ["Дирижабли и летающие машины собираются из блоков, по детали. В мире без координат вид сверху дорого стоит."]
	quest.17B27771CDB86A5A.quest_subtitle: "Машины, которые отрываются от земли"
	quest.189DB7B48428D3CF.quest_desc: [
		"&eПКМ&r включает и выключает рацию."
		""
		"&eДержи её в руке&r и говори: тебя слышат все, у кого включена рация на той же частоте, на любом расстоянии и с помехами."
		""
		"&b/radio freq <МГц>&r настраивает частоту (от 30.0 до 108.0)."
		""
		"&b/r <текст>&r отправляет сообщение на ту же частоту."
	]
	quest.189DB7B48428D3CF.quest_subtitle: "Одна частота — любое расстояние"
	quest.189DB7B48428D3CF.title: "Как работает рация"
	quest.1B43F5EAA670514E.quest_subtitle: "Артиллерия"
	quest.1C4B150B8A8CAAA7.quest_subtitle: "Склад и глубина"
	quest.1C93C15A5AEB0FD9.quest_desc: [
		"&eСтальной механизм&r — тяжёлый родственник точного механизма."
		""
		"От него идут четыре ветки: нефть и двигатели, артиллерия, полёты и радар."
	]
	quest.1C93C15A5AEB0FD9.quest_subtitle: "Сталь в движении"
	quest.20FA82989787B1DF.quest_desc: ["Провода Create Additions — для коротких линий: моторы и зарядка."]
	quest.20FA82989787B1DF.quest_subtitle: "Лёгкая электрика"
	quest.2396E60EE3374696.quest_desc: ["&eТермопара&r и &eогнеупорная футеровка&r собираются последовательной сборкой. Они нужны для коксовой печи, воздухонагревателя и самой домны."]
	quest.2396E60EE3374696.quest_subtitle: "Детали печи"
	quest.264F6C2DC0218409.quest_desc: [
		"Сталь и нефть добавляют сразу несколько модов. Здесь каждая есть только в &eодном варианте&r."
		""
		"&eСталь&r — из доменной печи The Factory Must Grow. &eНефть&r качают и перегоняют машинами того же мода."
		""
		"Рецепты других модов принимают эту сталь и это топливо."
	]
	quest.264F6C2DC0218409.quest_subtitle: "Без обходных путей"
	quest.264F6C2DC0218409.title: "Одна сталь, одна нефть"
	quest.28061CB26E1A0678.quest_subtitle: "Умная логистика"
	quest.29844BA2A2546B3C.quest_desc: [
		"Уходя из дома, запоминай дорогу назад. Ставь &eвышки&r, зажигай &eлампы&r, прокладывай &eдороги и рельсы&r: по ним теперь ориентируются."
		""
		"Объясняй друзьям, где ты, словами: «за озером, у высокой вышки, ищи дым»."
	]
	quest.29844BA2A2546B3C.quest_subtitle: "Твоя карта — ориентиры"
	quest.29844BA2A2546B3C.title: "Как не заблудиться"
	quest.2A4FF3ED81E25203.quest_desc: [
		"Компас здесь требует &eточный механизм&r."
		""
		"Он указывает на &eтвою точку спавна&r: кровать, а если кровати нет — место, где ты появился в последний раз."
	]
	quest.2A4FF3ED81E25203.quest_subtitle: "Дорога домой"
	quest.2A55E4ECF6567A43.quest_desc: [
		"&eКартон&r открывает логистику посылок: упаковщики, лягушачьи порты, складские тикеры."
		""
		"&eКорпус поезда&r открывает железные дороги. В мире без координат рельсы — это ещё и дорога, с которой не сбиться."
	]
	quest.2A55E4ECF6567A43.quest_subtitle: "Всё едет в коробке"
	quest.2CD9DA15A9C96299.quest_subtitle: "Вращение в ток и обратно"
	quest.31F6584EFCBA970A.quest_subtitle: "Автоматизация"
	quest.36192F56C7CCC3DC.quest_subtitle: "Прогулка по лаве"
	quest.3620191021E6CC88.quest_desc: ["Immersive Engineering — для дальних линий и тяжёлых машин."]
	quest.3620191021E6CC88.quest_subtitle: "Тяжёлая электрика"
	quest.369D420C48F88421.quest_subtitle: "Склад"
	quest.37592B85FD31945A.quest_subtitle: "Перемещение предметов"
	quest.389B5B3129B649F3.quest_desc: [
		"При первом входе ты появляешься в &eслучайном месте&r — и снова каждый раз, когда умираешь без кровати."
		""
		"Поспи в &eкровати&r, чтобы закрепить дом. Потеряешь кровать — потеряешь дорогу домой."
	]
	quest.389B5B3129B649F3.quest_subtitle: "Поспи перед дорогой"
	quest.389B5B3129B649F3.title: "Смерть и кровать"
	quest.3B62A756E25F92CE.quest_subtitle: "Трубы и баки"
	quest.3B9DF804448D5E3A.quest_subtitle: "Глаза за горизонтом"
	quest.3F002FD6B1090FC9.quest_desc: [
		"&eАндезитовый сплав&r открывает базовую кинетику: валы, шестерни, пресс, жернов, миксер, дрели и пилы."
		""
		"Машинам нужно вращение. Начни с &eводяного колеса&r или &eветряка&r."
	]
	quest.3F002FD6B1090FC9.quest_subtitle: "С него начинается любой завод"
	quest.409EC8A4147B7958.quest_desc: ["Некоторые детали собираются по шагам на конвейере: приложить, залить, спрессовать, повторить. &eТочный механизм&r — первая из них. Позже так же собираются детали доменной печи и нефтяной качалки."]
	quest.409EC8A4147B7958.quest_subtitle: "Один предмет, много шагов"
	quest.409EC8A4147B7958.title: "Последовательная сборка"
	quest.42B582D4ACEB31A2.quest_desc: [
		"Сборка рассчитана на &eголосовую связь внутри игры&r. Советуем говорить через игровой голосовой чат и рацию, а не через сторонние программы: тогда расстояние и частоты действительно что-то значат."
		""
		"В одиночку здесь тяжело. &eОбъединяйтесь в города&r: общая база, общие ориентиры и общая частота рации сильно упрощают поиск друг друга."
	]
	quest.42B582D4ACEB31A2.quest_subtitle: "Говорите голосом, стройте города"
	quest.42B582D4ACEB31A2.title: "Играйте вместе"
	quest.42F46883493F1690.quest_subtitle: "Точность"
	quest.440FFCE345D97BEB.quest_desc: [
		"Это сборка на &eCreate&r, в которой &eникто не знает, где находится&r."
		""
		"Заметки вокруг объясняют, что изменено и как этим пользоваться. Прочитал заметку — нажми &aгалочку&r, чтобы отметить её. За эту дают &e15 хлеба&r в дорогу."
		""
		"Потом открывай главы ступеней слева: они ведут от андезита к тяжёлой индустрии."
	]
	quest.440FFCE345D97BEB.quest_subtitle: "Начни отсюда"
	quest.440FFCE345D97BEB.title: "Добро пожаловать в Terra Incognita"
	quest.446232BD71A0783C.quest_subtitle: "Железная дорога"
	quest.45591406AE702E17.quest_desc: [
		"В этом мире &eнет координат&r. Экран F3 не показывает ни позицию, ни направление взгляда, а чат, команды и другие моды показывают заглушки на месте X Y Z."
		""
		"Так задумано. Другу не скинуть три числа — дорогу придётся объяснять словами."
	]
	quest.45591406AE702E17.quest_subtitle: "Ни на F3, нигде"
	quest.45591406AE702E17.title: "Координат нет"
	quest.490BA3F9D0D08D3A.quest_subtitle: "Мелочи"
	quest.4CA0D1B701FE55E2.quest_desc: ["Компас в латунных листах. Он указывает на &eцентр мира&r — одну точку для всех: общее место для встречи."]
	quest.4CA0D1B701FE55E2.quest_subtitle: "Дорога к центру"
	quest.50D3912B7539F0FD.quest_desc: [
		"Развитие разбито на шесть ступеней, по главе на каждую:"
		""
		"&71.&r Андезит  &72.&r Медь и жидкости  &73.&r Латунь"
		""
		"&74.&r Электричество и сталь  &75.&r Логистика и поезда  &76.&r Тяжёлая индустрия"
		""
		"&eШестерня&r в центре главы открывает ступень. &eРомбы&r — её ключевые машины."
	]
	quest.50D3912B7539F0FD.quest_subtitle: "От андезита до неба"
	quest.50D3912B7539F0FD.title: "Шесть ступеней"
	quest.566B8936550C9A4D.quest_desc: [
		"Чат &eлокальный&r: сообщение видят только игроки в &e60 блоках&r от тебя."
		""
		"Чтобы написать тому, кто далеко, нужна рация: &b/r <текст>&r."
	]
	quest.566B8936550C9A4D.quest_subtitle: "Слышен на 60 блоков"
	quest.566B8936550C9A4D.title: "Текстовый чат"
	quest.588C906CB5C41F0E.quest_subtitle: "Подвижные конструкции"
	quest.599F09C1CC31CB92.quest_desc: ["Для добычи и перегонки нефти нужен &eманометр&r."]
	quest.599F09C1CC31CB92.quest_subtitle: "Нефть и двигатели"
	quest.5F7359B8B5F2A6EA.quest_desc: ["&eМедный корпус&r и &eжелезные листы&r открывают жидкости: трубы, насосы, баки, дозатор и паровой двигатель — первый серьёзный источник вращения."]
	quest.5F7359B8B5F2A6EA.quest_subtitle: "Всё начинает течь"
	quest.61438AC938544407.quest_desc: [
		"В сборке стоит Simple Voice Chat. Голос слышен примерно на &e48 блоков&r, шёпот — примерно на половину этого."
		""
		"&eГруппы&r голосового чата &eвыключены&r для всех. Дальняя голосовая связь — только по рации."
		""
		"Микрофон настраивается в меню голосового чата (по умолчанию &bV&r)."
	]
	quest.61438AC938544407.quest_subtitle: "Говори с теми, кто рядом"
	quest.61438AC938544407.title: "Голосовой чат"
	quest.621FE435A2FBBB0D.quest_subtitle: "Дорога к стали"
	quest.68FF1B07B1839831.quest_subtitle: "Жидкости в деле"
	quest.698F0FFF17CCAF93.quest_subtitle: "Редстоун и транспорт"
	quest.6D6EF2E6F0E90114.quest_desc: [
		"Многие рецепты сложнее обычных и связаны между собой. Не крафти по памяти."
		""
		"Наведи на предмет и нажми &bR&r — как он делается, &bU&r — где используется."
	]
	quest.6D6EF2E6F0E90114.quest_subtitle: "Смотри, прежде чем крафтить"
	quest.6D6EF2E6F0E90114.title: "Рецепты изменены"
	quest.6FEE6AE08B1D54B5.quest_subtitle: "Вращение"
	quest.77182E8748F6D8DF.quest_desc: [
		"Точный механизм, громоотвод вместо антенны, железные листы и редстоун."
		""
		"Как ей пользоваться — в заметке &eКак работает рация&r выше."
	]
	quest.77182E8748F6D8DF.quest_subtitle: "Дальняя связь"
	quest.78320318B62C021A.quest_desc: [
		"Каждый источник даёт &eзапас нагрузки&r, каждая машина его тратит. Если расход больше, вся сеть останавливается. Цифры показывают инженерные очки."
		""
		"Большая шестерня, вращающая малую, удваивает скорость и удваивает расход нагрузки."
	]
	quest.78320318B62C021A.quest_subtitle: "Почему машина встала"
	quest.78320318B62C021A.title: "Нагрузка и скорость"
	quest.7A0344E3214AC811.quest_subtitle: "Обработка"
	quest.7A7B3E8DCEBE49EE.quest_desc: ["Нефть качают и перегоняют только машинами The Factory Must Grow."]
	quest.7A7B3E8DCEBE49EE.quest_subtitle: "Одна нефть на всю сборку"
	quest.7BF5F030B7EC13A8.quest_subtitle: "Топливо во вращение"
	quest.7C330F27218517C7.quest_desc: [
		"Не играл в Create? Наведи на предмет Create в инвентаре и &eзажми &bW&r: анимированная сцена покажет, как работает машина."
		""
		"&eИнженерные очки&r показывают скорость и нагрузку машины, на которую смотришь."
	]
	quest.7C330F27218517C7.quest_subtitle: "Зажми W — «Обдумать»"
	quest.7C330F27218517C7.title: "Как учить Create"
	quest.7F6E0F85C6D534C7.quest_desc: [
		"&eПрокатный стан&r делает из слитков прутки и проволоку. С него начинается электричество."
		""
		"От него идут три ветки: лёгкая электрика, тяжёлая электрика и дорога к &eстали&r."
	]
	quest.7F6E0F85C6D534C7.quest_subtitle: "Прутки и проволока"
}
